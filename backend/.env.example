# Скопируйте в .env и подставьте свои значения.
# Для развёртывания с доступом из сети: обязательно смените JWT_SECRET, пароль БД и INIT_ADMIN_PASSWORD.
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/openvpn_control?schema=public
JWT_SECRET=super_secret_replace_in_prod
MFA_PENDING_TOKEN_EXPIRES_IN=5m
PANEL_BACKUP_DIR=./data/panel-backups
CORS_ORIGIN=http://localhost:5173
ALLOWED_HOSTS=localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CSRF_PROTECTION_ENABLED=true
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15
AGENT_SYNC_INTERVAL_MS=2000
OPENVPN_INFO_SYNC_INTERVAL_MS=5000
CLIENT_SYNC_INTERVAL_MS=2000
CLIENT_SESSION_FRESHNESS_SECONDS=15
CLIENT_TRAFFIC_HISTORY_MINUTES=15
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change_me
