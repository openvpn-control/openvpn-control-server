# PostgreSQL
POSTGRES_DB=openvpn_control
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend
BACKEND_PORT=8080
JWT_SECRET=dev_secret_change_me
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

# Edge nginx (панель: http://localhost/ или ваш хост из hosts)
CERTBOT_PRIMARY_DOMAIN=panel.example.com
CERTBOT_EMAIL=admin@example.com
# CERTBOT_STAGING=1

# Явный URL API для фронта (опционально). Пусто = тот же origin, что и панель.
# PUBLIC_BASE_URL=https://panel.example.com

# Добавьте свой hostname из hosts (например ovp-control-console)
CORS_ORIGIN=http://localhost,http://127.0.0.1,http://ovp-control-console,https://localhost
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://ovp-control-console,https://localhost
# ALLOWED_HOSTS пусто = хосты берутся из CORS_ORIGIN (localhost, ovp-control-console, …)
