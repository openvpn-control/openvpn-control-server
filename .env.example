# PostgreSQL
POSTGRES_DB=openvpn_control
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend (Go)
JWT_SECRET=dev_secret_change_me
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

# Панель: http://localhost:8080/  API: http://localhost:8080/api/ (прокси frontend → backend)
HTTP_PORT=8080
# PUBLIC_BASE_URL=  # пусто = тот же origin, что и панель

# CORS/CSRF на backend не нужны, пока API идёт через frontend (same-origin).
# Включите только если браузер бьётся в API напрямую (другой порт/хост, API_URL в index.html):
# CORS_PROTECTION_ENABLED=true
# CSRF_PROTECTION_ENABLED=true
# CORS_ORIGIN=http://localhost:8080
# CSRF_TRUSTED_ORIGINS=http://localhost:8080

LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15
AGENT_SYNC_INTERVAL_MS=2000
CLIENT_SYNC_INTERVAL_MS=2000
CLIENT_SESSION_FRESHNESS_SECONDS=15
CLIENT_TRAFFIC_HISTORY_MINUTES=15
AGENT_METRIC_HISTORY_MINUTES=15

# Продакшен-образы (docker-compose.prod.yml)
IMAGE_REGISTRY=ghcr.io/openvpn-control
IMAGE_TAG=latest
